# Backend Environment Variables

## AWS Configuration
AWS_REGION=eu-north-1
AWS_PROFILE=prod

## DynamoDB Table Names
RACES_TABLE_NAME=running-race-tracker-races
STRAVA_IMPORTS_TABLE_NAME=running-race-tracker-strava-imports

## Cognito Configuration
COGNITO_REGION=eu-north-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

## Strava Integration (Phase 5)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://your-domain/strava/callback

## Google OAuth -> Cognito Federation (optional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

## Terraform Variables
TF_VAR_aws_region=eu-north-1
TF_VAR_aws_profile=prod
TF_VAR_bucket_name=running-race-tracker-app
TF_VAR_domain_name=running.mandla.tech
TF_VAR_certificate_arn=
TF_VAR_cloudfront_aliases='["running.mandla.tech"]'
TF_VAR_acm_certificate_domain=*.mandla.tech
TF_VAR_google_oauth_client_id=
TF_VAR_google_oauth_client_secret=
